# RVPI Automation / Restore Host runs on 10.10.10.13.
# PVE_URL is the PROXMOX HYPERVISOR management endpoint, not 10.10.10.13.
# The Proxmox management address is not confirmed. Leave this placeholder
# until an administrator supplies the correct hostname or IP.
PVE_URL=https://YOUR-PROXMOX-MANAGEMENT-HOST:8006

# Replace with an actual least-privilege read-only Proxmox API token ID.
# Keep real token secrets OUTSIDE GitHub; never put secrets in this file.
PVE_TOKEN_ID=YOUR-READONLY-TOKEN-ID
PVE_TOKEN_SECRET=SET_LOCALLY_NOT_IN_GITHUB

# Local filesystem path on host 10.10.10.13 to a trusted Proxmox CA cert.
# This is NOT the TLS certificate used for RVPI telemetry on VM 102.
PVE_CA_CERT=/path/on/automation-host/to/proxmox-ca.pem
